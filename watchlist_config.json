{
  "$schema": "./watchlist_schema.json",
  "version": "1.1.0",
  "folder_structure": "by_ticker",
  "schedule": {
    "description": "美股收盘后每日定时自动抓取 (周一至周五 美东时间 16:30 / UTC 20:30)",
    "cron": "30 20 * * 1-5",
    "timezone": "America/New_York"
  },
  "timeframes": [
    {
      "interval": "1d",
      "period": "3mo",
      "label": "日线 3个月"
    },
    {
      "interval": "1h",
      "period": "1mo",
      "label": "1小时 1个月"
    }
  ],
  "tickers": [
    "TSM",
    "NTSK",
    "SPCX",
    "MU",
    "CRM",
    "MSFT"
  ],
  "output_dir": "kline_data"
}
